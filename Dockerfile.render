# selfmade-render — Remotion export worker container (Phase 1 Step 4).
# Build from the REPO ROOT so it can copy remotion/, src/lib/video, and the worker script.
#   docker build -f Dockerfile.render -t selfmade-render .
# Runs worker/src/render-worker.mjs, which renders timelines via Remotion → MP4 → R2.

FROM node:20-slim

# Chromium/headless-shell + ffmpeg system libraries Remotion needs on Debian.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates fonts-liberation ffmpeg \
    libnss3 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
    libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 \
    libasound2 libpango-1.0-0 libcairo2 libatspi2.0-0 libxshmfence1 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install the Remotion render engine (cached layer — only re-runs when its lockfile changes).
COPY remotion/package.json remotion/package-lock.json ./remotion/
RUN cd remotion && npm ci --no-audit --no-fund

# The composition imports ../../src/lib/video/timeline — preserve the repo shape.
COPY remotion ./remotion
COPY src/lib/video ./src/lib/video
COPY worker/src/render-worker.mjs ./worker/src/render-worker.mjs

# The render worker's only dependency (R2 upload). Kept at /app so it resolves from /app/worker/src.
RUN npm init -y >/dev/null 2>&1 && npm i @aws-sdk/client-s3@3 --no-audit --no-fund

# Pre-download the headless browser so the first render doesn't stall (best-effort).
RUN cd remotion && npx remotion browser ensure || true

ENV REMOTION_DIR=/app/remotion
CMD ["node", "worker/src/render-worker.mjs"]
