# Copy to .env and fill in. Never commit .env.

# ── Supabase (admin key — same as Vercel SUPABASE_SERVICE_ROLE_KEY) ──
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# ── Cloudflare R2 (same values as Vercel) ──
R2_ACCOUNT_ID=07d931791a32f84febbcae52361feb71
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=selfmade-ads
R2_PUBLIC_URL=https://pub-4923da4504674f3ea83f76847da04b3b.r2.dev

# ── Tuning (defaults are sane for 8GB droplet) ──
WORKER_CONCURRENCY=8
WORKER_BATCH_SIZE=50
WORKER_EMPTY_SLEEP_MS=30000
WORKER_BATCH_SLEEP_MS=500
WORKER_AD_TIMEOUT_MS=60000
# Set to 1 to skip videos initially (faster, smaller storage)
WORKER_IMAGES_ONLY=0

# ── IPRoyal Residential Proxy (REQUIRED at scale) ──
# Without these the worker hits Meta direct → IP gets blocked within hours.
# Sticky session per ad: same residential IP for HTML+JS+CDN of one ad.
WORKER_PROXY_HOST=geo.iproyal.com
WORKER_PROXY_PORT=12321
WORKER_PROXY_USER=your_iproyal_username
WORKER_PROXY_PASS=your_iproyal_password
WORKER_PROXY_COUNTRY=us
